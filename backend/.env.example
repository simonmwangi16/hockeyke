# HockeyKE reads process environment variables directly. This file is a
# reference template only; it is not loaded automatically.
#
# manage.py, WSGI, and ASGI all use DJANGO_SETTINGS_MODULE=config.settings.
# config.settings selects development by default. Production is selected only
# when HOCKEYKE_ENV=production is explicitly supplied.

# Development (optional local overrides)
HOCKEYKE_ENV=development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_DB_ENGINE=mysql
DJANGO_DB_NAME=hkenewdb
DJANGO_DB_USER=root
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=3306

# Production
# Set HOCKEYKE_ENV=production explicitly. The variables marked REQUIRED must
# contain deployment-specific values; the placeholders below are not usable
# credentials and must not be copied into a real deployment unchanged.
#
# HOCKEYKE_ENV=production
# DJANGO_SECRET_KEY=REQUIRED-use-a-unique-random-value-of-at-least-50-characters
# DJANGO_ALLOWED_HOSTS=REQUIRED-example.com,www.example.com
# DJANGO_DB_NAME=REQUIRED-production-database-name
# DJANGO_DB_USER=REQUIRED-production-database-user
# DJANGO_DB_PASSWORD=REQUIRED-production-database-password
# DJANGO_DB_HOST=REQUIRED-production-database-host
# DJANGO_DB_PORT=3306
# DJANGO_DB_CONN_MAX_AGE=60
# DJANGO_STATIC_ROOT=/absolute/path/to/public/static
# DJANGO_MEDIA_ROOT=/absolute/path/to/public/media
# DJANGO_CORS_ALLOWED_ORIGINS=https://example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=3600
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# DJANGO_SECURE_HSTS_PRELOAD=false
